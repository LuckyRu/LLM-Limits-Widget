<UserControl x:Class="LLMLimitsWidget.FloatingOverlay.LimitMetricControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:LLMLimitsWidget.FloatingOverlay"
             Width="75"
             Height="43"
             Background="Transparent">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="43" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="4" />
        </Grid.ColumnDefinitions>
        <local:CircularMeter x:Name="Meter"
                             Grid.Column="0"
                             Width="43"
                             Height="43"
                             HorizontalAlignment="Left"
                             VerticalAlignment="Center" />
        <TextBlock x:Name="PeriodLabel"
                   Grid.Column="1"
                   VerticalAlignment="Center"
                   Style="{StaticResource TinyLabel}"
                   FontSize="12" />
    </Grid>
</UserControl>
