<UserControl x:Class="LLMLimitsWidget.FloatingOverlay.ProviderRowControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:LLMLimitsWidget.FloatingOverlay"
             Height="47"
             Background="Transparent">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ProviderColumn" Width="28" />
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Border x:Name="ProviderSurface"
                Grid.Column="0"
                Width="24"
                Height="24"
                CornerRadius="7"
                VerticalAlignment="Center">
            <local:ProviderLogo x:Name="ProviderMark"
                                Width="17"
                                Height="17"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
        </Border>

        <Grid Grid.Column="1" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="MetricOneColumn" Width="75" />
                <ColumnDefinition x:Name="MetricTwoColumn" Width="0" />
            </Grid.ColumnDefinitions>
            <local:LimitMetricControl x:Name="MetricOne" Grid.Column="0" HorizontalAlignment="Left" />
            <local:LimitMetricControl x:Name="MetricTwo" Grid.Column="1" HorizontalAlignment="Left" />
        </Grid>

        <StackPanel Grid.Column="2" VerticalAlignment="Center">
            <TextBlock x:Name="CountdownText" FontSize="14" FontWeight="SemiBold" />
            <TextBlock x:Name="ResetText"
                       Style="{StaticResource TinyLabel}"
                       FontSize="11"
                       Margin="0,2,0,0" />
        </StackPanel>
    </Grid>
</UserControl>
