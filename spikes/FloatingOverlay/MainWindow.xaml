<Window x:Class="LLMLimitsWidget.FloatingOverlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LLMLimitsWidget.FloatingOverlay"
        Title="LLM Limits Widget"
        Width="285"
        Height="103"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        Loaded="Window_Loaded"
        IsVisibleChanged="Window_IsVisibleChanged"
        Closed="Window_Closed"
        SourceInitialized="Window_SourceInitialized"
        Deactivated="Window_Deactivated"
        LostMouseCapture="Window_LostMouseCapture"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewMouseLeftButtonDown="Window_PreviewMouseLeftButtonDown"
        PreviewMouseLeftButtonUp="Window_PreviewMouseLeftButtonUp"
        PreviewMouseMove="Window_PreviewMouseMove">
    <Window.Resources>
        <ContextMenu x:Key="WidgetContextMenu" Opened="WidgetContextMenu_Opened" Closed="WidgetContextMenu_Closed">
            <MenuItem Header="Вертикальная раскладка" Click="VerticalLayoutMenuItem_Click" />
            <MenuItem Header="Горизонтальная раскладка" Click="HorizontalLayoutMenuItem_Click" />
            <Separator />
            <MenuItem Header="Масштаб 80%" Tag="0.8" Click="ScaleMenuItem_Click" />
            <MenuItem Header="Масштаб 100%" Tag="1.0" Click="ScaleMenuItem_Click" />
            <MenuItem Header="Масштаб 120%" Tag="1.2" Click="ScaleMenuItem_Click" />
            <MenuItem Header="Масштаб 150%" Tag="1.5" Click="ScaleMenuItem_Click" />
            <MenuItem Header="Масштаб 180%" Tag="1.8" Click="ScaleMenuItem_Click" />
            <Separator />
            <MenuItem StaysOpenOnClick="True">
                <MenuItem.Header>
                    <StackPanel Width="214" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Width="92" Text="Прозрачность" VerticalAlignment="Center" />
                        <Slider Width="84"
                                Minimum="0.2"
                                Maximum="1"
                                Value="1"
                                TickFrequency="0.1"
                                VerticalAlignment="Center"
                                ValueChanged="SurfaceOpacitySlider_ValueChanged" />
                    </StackPanel>
                </MenuItem.Header>
            </MenuItem>
            <MenuItem Header="Обновить" Click="RefreshMenuItem_Click" />
            <MenuItem Header="Сбросить позицию" Click="ResetPositionMenuItem_Click" />
            <MenuItem Header="Скрыть виджет" Click="HideMenuItem_Click" />
            <Separator />
            <MenuItem Header="Выйти" Click="ExitMenuItem_Click" />
        </ContextMenu>
    </Window.Resources>
    <Viewbox Stretch="Uniform" StretchDirection="Both">
        <Border x:Name="Surface"
                Width="285"
                Height="103"
                Margin="1"
                Padding="9,3"
                CornerRadius="18"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource SurfaceBorderBrush}"
                BorderThickness="1"
                ContextMenu="{StaticResource WidgetContextMenu}"
                ContextMenuOpening="Surface_ContextMenuOpening"
                MouseLeftButtonDown="Surface_MouseLeftButtonDown">
            <Grid x:Name="Root">
                <Grid x:Name="VerticalLayout">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="47" />
                        <RowDefinition Height="1" />
                        <RowDefinition Height="47" />
                    </Grid.RowDefinitions>
                    <local:ProviderRowControl Grid.Row="0"
                                              Provider="OpenAi"
                                              Accent="{StaticResource CodexBrush}"
                                              MetricOneValue="62"
                                              MetricOnePercent="62%"
                                              MetricOnePeriod="W"
                                              Countdown="◷ 07:03"
                                              ResetLabel="18 Aug · reset" />
                    <Border Grid.Row="1" Background="{StaticResource DividerBrush}" />
                    <local:ProviderRowControl Grid.Row="2"
                                              Provider="Claude"
                                              Accent="{StaticResource ClaudeBrush}"
                                              MetricOneValue="5"
                                              MetricOnePercent="5%"
                                              MetricOnePeriod="5h"
                                              MetricTwoValue="70"
                                              MetricTwoPercent="70%"
                                              MetricTwoPeriod="7d"
                                              HasSecondMetric="True"
                                              Countdown="◷ 00:30"
                                              ResetLabel="13 Aug · reset" />
                </Grid>

                <Grid x:Name="HorizontalLayout" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <local:ProviderRowControl Grid.Column="0"
                                              Compact="True"
                                              Provider="OpenAi"
                                              Accent="{StaticResource CodexBrush}"
                                              MetricOneValue="62"
                                              MetricOnePercent="62%"
                                              MetricOnePeriod="W"
                                              Countdown="◷ 07:03"
                                              ResetLabel="18 Aug · reset" />
                    <Border Grid.Column="1"
                            Width="1"
                            Height="40"
                            Margin="8,0"
                            VerticalAlignment="Center"
                            Background="{StaticResource DividerBrush}" />
                    <local:ProviderRowControl Grid.Column="2"
                                              Compact="True"
                                              Provider="Claude"
                                              Accent="{StaticResource ClaudeBrush}"
                                              MetricOneValue="5"
                                              MetricOnePercent="5%"
                                              MetricOnePeriod="5h"
                                              MetricTwoValue="70"
                                              MetricTwoPercent="70%"
                                              MetricTwoPeriod="7d"
                                              HasSecondMetric="True"
                                              Countdown="◷ 00:30"
                                              ResetLabel="13 Aug · reset" />
                </Grid>
            </Grid>
        </Border>
    </Viewbox>
</Window>
