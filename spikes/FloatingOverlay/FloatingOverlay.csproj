<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\llm-limits-tray.ico</ApplicationIcon>
    <AssemblyName>LLMLimitsWidget.FloatingOverlay</AssemblyName>
    <RootNamespace>LLMLimitsWidget.FloatingOverlay</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Assets\llm-limits-tray.ico" />
    <ProjectReference Include="..\..\src\LLMLimitsWidget.Application\LLMLimitsWidget.Application.csproj" />
    <ProjectReference Include="..\..\src\LLMLimitsWidget.Infrastructure.Windows\LLMLimitsWidget.Infrastructure.Windows.csproj" />
    <ProjectReference Include="..\..\src\LLMLimitsWidget.Presentation\LLMLimitsWidget.Presentation.csproj" />
  </ItemGroup>
  <Target Name="BuildClaudeStatusLineBridge" AfterTargets="Build" Condition="'$(SkipClaudeStatusLineBridgeBuild)' != 'true'">
    <MSBuild Projects="$(MSBuildProjectDirectory)\..\..\src\LLMLimitsWidget.ClaudeStatusLineBridge\LLMLimitsWidget.ClaudeStatusLineBridge.csproj"
             Targets="Build"
             Properties="Configuration=$(Configuration);UseSharedCompilation=$(UseSharedCompilation);RuntimeIdentifier=;SelfContained=false" />
    <ItemGroup>
      <ClaudeStatusLineBridgeFiles Include="$(MSBuildProjectDirectory)\..\..\src\LLMLimitsWidget.ClaudeStatusLineBridge\bin\$(Configuration)\net10.0-windows\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(ClaudeStatusLineBridgeFiles)"
          DestinationFiles="@(ClaudeStatusLineBridgeFiles->'$(OutDir)claude-statusline-bridge\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>
  <Target Name="CopyClaudeStatusLineBridgeToPublish" AfterTargets="Publish" DependsOnTargets="BuildClaudeStatusLineBridge">
    <ItemGroup>
      <PublishedClaudeStatusLineBridgeFiles Include="$(MSBuildProjectDirectory)\..\..\src\LLMLimitsWidget.ClaudeStatusLineBridge\bin\$(Configuration)\net10.0-windows\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(PublishedClaudeStatusLineBridgeFiles)"
          DestinationFiles="@(PublishedClaudeStatusLineBridgeFiles->'$(PublishDir)claude-statusline-bridge\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
